# Build output — regenerated by `mkdocs build`, never source of truth.
site/

# The Constle source repository, checked out here so pymdownx.snippets can
# resolve the README and spec sections the pages pull in. CI creates it with a
# second actions/checkout step; locally, see README.md. It is somebody else's
# repository — it must never be committed into this one.
_upstream/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Python — mkdocs and mkdocs-material tooling
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Never, under any circumstance
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
.ssh/
